rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /customers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == "Pending";
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        request.auth != null && resource.data.uid == request.auth.uid &&
        resource.data.status == "Pending" && request.resource.data.status == "Cancelled" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "cancelledBy", "cancelReason", "cancelledAt"]));
      allow delete: if isAdmin();
    }
    match /chats/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
      match /messages/{mid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && ((request.auth.uid == uid && request.resource.data.from == "customer")
              || (isAdmin() && request.resource.data.from == "admin"));
        allow delete: if isAdmin();
      }
    }
  }
}
